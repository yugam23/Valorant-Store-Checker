# ---------------------------------------------------------------------------
# Valorant Store Checker — self-hosting configuration
# Copy this file to `.env` (Docker) or `.env.local` (local dev) and fill it in.
# Never commit the filled-in file.
# ---------------------------------------------------------------------------

# REQUIRED. Signs the session JWT stored in the HTTP-only cookie. Min 32 chars.
#   openssl rand -base64 32
SESSION_SECRET=

# REQUIRED in production. AES-256-GCM key that encrypts Riot cookies at rest.
# Must be exactly 64 hex characters (32 bytes).
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Optional. HenrikDev API key for rank / level data (https://docs.henrikdev.xyz).
# The profile page degrades gracefully without it.
HENRIK_API_KEY=

# Optional. Host port the app is published on (docker-compose only).
APP_PORT=3000

# Optional. Log level: debug | info | warn | error (default: warn in production).
LOG_LEVEL=warn

# Optional. Path of the SQLite session database, relative to the app directory.
# The Docker image defaults this to data/sessions.db, which is a persistent volume.
# SESSION_DB_PATH=data/sessions.db

# Optional. Use a remote LibSQL / Turso database instead of the local SQLite file.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# REQUIRED for docker-compose. Token for the bundled Redis REST proxy (SRH),
# which powers the profile/store cache and auth rate limiting.
#   openssl rand -hex 32
SRH_TOKEN=

# Optional. Upstash Redis for auth rate limiting + serverless cache persistence.
# docker-compose uses the bundled Redis unless these are set. Outside Docker,
# rate limiting fails open (disabled) when these are not set. On Vercel, the
# Marketplace Upstash integration's KV_REST_API_URL / KV_REST_API_TOKEN also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_REQS_PER_MIN=10
